{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "inputs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "snapshot": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid"
        }
      }
    }
  }
}
