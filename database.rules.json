{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostUid').exists()"
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostUid').exists()"
          }
        },
        "shots": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('o').val() === auth.uid && data.parent().parent().child('hostUid').exists()"
          }
        },
        "hits": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('v').val() === auth.uid && data.parent().parent().child('hostUid').exists()"
          }
        }
      }
    }
  }
}
